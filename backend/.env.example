# Скопіюйте у .env і змініть за потреби. Файл .env не комітиться.
# Мінімальна впевненість AI (0..1). Нижче — категорія "other" і прохання обрати вручну.
AI_MIN_CONFIDENCE=0.30
# true — AI-компонент завжди повертає помилку (для перевірки сценарію «AI недоступний»).
AI_SIMULATE_FAILURE=false
# Необов'язковий ключ доступу. Якщо задано, клієнт має передавати заголовок X-API-Key.
API_KEY=
MAX_TEXT_LENGTH=200
